{
  "model_name": "Qwen/Qwen3.5-2B",
  "dataset_path": "outputs/sft/accepted-qwen-clean.jsonl",
  "output_dir": "outputs/sft/checkpoint-qwen",
  "use_lora": true,
  "action_only": true,
  "num_train_epochs": 2,
  "max_length": 8192,
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 1,
  "learning_rate": 0.0002,
  "seed": 42,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "lora_target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj",
    "in_proj_qkv",
    "in_proj_z",
    "in_proj_b",
    "in_proj_a",
    "out_proj"
  ]
}
