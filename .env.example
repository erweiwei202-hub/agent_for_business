# Copy this file to .env and fill in the secret.
# .env is ignored by git; never commit the real key.

# Anthropic Messages protocol through DeepSeek's Anthropic-compatible endpoint.
ANTHROPIC_API_KEY=replace-with-your-deepseek-key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# LiteLLM provider-qualified model names.
AGENT_LLM=anthropic/deepseek-v4-flash
USER_LLM=anthropic/deepseek-v4-flash

# Local student model name used by the SFT command.
QWEN_MODEL=Qwen/Qwen3.5-2B
